# FalkorDB. Local Docker needs nothing. For a cloud instance use one URL (falkors:// = TLS, used by paid tiers):
# FALKORDB_URL=falkors://<user>:<password>@<host>:<port>
FALKORDB_GRAPH=marvel

# Chat model: any OpenAI-compatible endpoint. Default = free open models on OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# First model is used; the next ones are fallbacks. Paid flash models cost about $0.0003 per question.
LLM_MODEL=deepseek/deepseek-v4.1-flash,qwen/qwen3.8-flash,deepseek/deepseek-v4-flash-0731:free
